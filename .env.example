APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./callflow.db
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=northstar-hvac

# Required to enable protected knowledge-ingestion / approval writes in demo or production.
# Send it as the X-Admin-Key request header. Leave unset to disable those writes publicly.
ADMIN_API_KEY=

# Optional live LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_COST_PER_MILLION=0.40
OPENAI_OUTPUT_COST_PER_MILLION=1.60

# Required when DEMO_MODE=false
HUBSPOT_ACCESS_TOKEN=

# Required when DEMO_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Required for live voice traffic when DEMO_MODE=false
VAPI_WEBHOOK_SECRET=

HTTP_TIMEOUT_SECONDS=8
MAX_EXTERNAL_RETRIES=2
