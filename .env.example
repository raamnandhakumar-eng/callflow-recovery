APP_ENV=development
DATABASE_URL=sqlite:///./callflow.db
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=northstar-hvac

# Optional live LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_COST_PER_MILLION=0.40
OPENAI_OUTPUT_COST_PER_MILLION=1.60

# Optional HubSpot CRM
HUBSPOT_ACCESS_TOKEN=

# Optional Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Vapi verification
VAPI_WEBHOOK_SECRET=

HTTP_TIMEOUT_SECONDS=8
MAX_EXTERNAL_RETRIES=2
